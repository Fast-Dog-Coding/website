# Copy to .env and adjust for your machine.
DATABASE_URL=postgresql://localhost:5432/fdc_website
# Direct connection for prisma db push and `npm run sync:db`. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://localhost:5432/fdc_website
REVALIDATION_SECRET=dev-secret-change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portfolio API key issued by resume-master. Used by prisma db seed, `npm run sync:db`,
# and POST /api/sync. Never commit a real key.
RESUME_API_KEY=
# Optional alias used when RESUME_API_KEY is unset.
# RESUME_API_KEY_PORTFOLIO=

# Optional resume-master origin. Defaults to https://resume-master-nu.vercel.app.
# RESUME_SERVICE_URL=https://resume-master-nu.vercel.app

# Optional site origin for `npm run revalidate` and the revalidation step of `npm run sync:db`.
# Defaults to NEXT_PUBLIC_SITE_URL, then https://fastdogcoding.com.
# A CLI argument wins: npm run revalidate -- https://fastdogcoding.com
# REVALIDATE_SITE_URL=http://localhost:3000
